# ============================================================
# Dy3+ Polaris LLM 接入配置模板
# ============================================================
# 使用说明:
#   1. 复制本文件为 .env (不要提交 .env 到版本库!)
#      Windows:  copy .env.example .env
#      Linux/Mac: cp .env.example .env
#   2. 选择一家 provider, 填入你的 API Key
#   3. 无需重启即可生效 (首次调用时读取)
#
# 安全提示:
#   - .gitignore 只能防止常规 Git 提交，不能防止整目录备份/分享泄漏
#   - 生产密钥优先由操作系统环境或密钥管理器注入，不长期存放在项目目录
#   - 任何曾经出现在聊天、日志或共享文件中的密钥都必须立即撤销并轮换
#   - 密钥只用于运行时调用 LLM, 不会写入日志/报告/序列化输出
# ============================================================

# ---- 默认服务商 (deepseek / anthropic / openai / qwen / zhipu / ollama / custom) ----
DY3_LLM_PROVIDER=deepseek

# ---- API 密钥 (ollama 本地模型无需填写) ----
DY3_LLM_API_KEY=sk-你的密钥

# ---- 可选: Neo4j (仅在启用外部图存储时填写) ----
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=请从密钥管理器注入

# ---- 可选: 自定义 base_url / model (不填则用服务商默认) ----
# DY3_LLM_BASE_URL=https://api.deepseek.com
# DY3_LLM_MODEL=deepseek-v4-flash

# ---- 多模型角色路由（产品运行默认开启） ----
# 仅配置上面的 DeepSeek Key 时，系统会自动使用：
#   快速候选 deepseek-v4-flash；长文/深度候选/审核 deepseek-v4-pro。
# 如同时配置下列官方密钥，系统会自动发挥跨厂商模型特长：
#   长文本 Claude Sonnet 5；深度候选 GPT-5.6 Terra；审核 GPT-5.6 Sol。
DY3_MULTI_MODEL_ENABLED=true
# ANTHROPIC_API_KEY=请从密钥管理器注入
# OPENAI_API_KEY=请从密钥管理器注入

# 每个角色均可显式覆盖 provider/model；未填写时使用上述自动路由。
# DY3_LLM_GENERATION_LONG_PROVIDER=anthropic
# DY3_LLM_GENERATION_LONG_MODEL=claude-sonnet-5
# DY3_LLM_GENERATION_DEEP_PROVIDER=openai
# DY3_LLM_GENERATION_DEEP_MODEL=gpt-5.6-terra
# DY3_LLM_REVIEW_PROVIDER=openai
# DY3_LLM_REVIEW_MODEL=gpt-5.6-sol

# ---- ollama 本地模型示例 (免密钥, 数据不出本机) ----
# DY3_LLM_PROVIDER=ollama
# DY3_LLM_BASE_URL=http://localhost:11434/v1
# DY3_LLM_MODEL=qwen2.5:7b
# DY3_LLM_TIMEOUT=120

# ---- 可选: 生成参数 ----
# DY3_LLM_TEMPERATURE=0.3
# DY3_LLM_MAX_TOKENS=2048
# DY3_LLM_TIMEOUT=120
